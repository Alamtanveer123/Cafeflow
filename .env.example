# ==============================================================================
# CafeFlow Backend Configuration Template (.env.example)
# Copy this file to `server/.env` and adjust the variables for your environment.
# DO NOT COMMIT REAL CREDENTIALS OR TOKENS TO GIT.
# ==============================================================================

# Server Network Configuration
PORT=5001
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Database Connection (MongoDB)
# Local instance default: mongodb://localhost:27017/cafeflow
MONGODB_URI=mongodb://localhost:27017/cafeflow

# Authentication & Security
# Generate a secure string (minimum 32 characters) for JWT signing
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long_cafeflow_2026
JWT_EXPIRES_IN=7d

# Cafe Business Configuration
# Set tax rate percentage (e.g. 5.0 for 5%, 0.0 for zero tax)
TAX_RATE_PERCENTAGE=0.0
